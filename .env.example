# Obbligatoria per eseguire il modello reale.
OPENAI_API_KEY=

# Modello economico per il loop e modello forte per richieste complesse.
OPENAI_MODEL=gpt-5.4-mini
OPENAI_STRONG_MODEL=gpt-5.5

# Limiti del runner.
HARNESS_MAX_CONTINUATIONS=3
HARNESS_MAX_TOOL_CALLS=40
HARNESS_TOOL_OUTPUT_LIMIT=12000

# Funzioni opzionali.
HARNESS_ENABLE_WEB_SEARCH=true
HARNESS_ENABLE_BROWSER=true
HARNESS_ENABLE_MCP=true
HARNESS_REQUIRE_APPROVAL=true

# Tracing opzionale.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langchain-agent-harness

# Immagine costruita con: make sandbox-image
HARNESS_SANDBOX_IMAGE=langchain-harness-sandbox:latest

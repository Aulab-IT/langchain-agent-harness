# Chiave OpenAI. Serve solo se almeno un gradino usa il provider "openai" (default).
OPENAI_API_KEY=

# Provider per gradino: openai (default) | anthropic (Claude) | ollama | mlx.
# Esempio "locale + Claude": gradino basso in locale, i due alti su Claude.
#   HARNESS_PROVIDER_LOW=ollama
#   HARNESS_PROVIDER_MID=anthropic
#   HARNESS_PROVIDER_HIGH=anthropic
HARNESS_PROVIDER_LOW=openai
HARNESS_PROVIDER_MID=openai
HARNESS_PROVIDER_HIGH=openai

# Claude (Anthropic). Serve la chiave solo se un gradino usa il provider "anthropic".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_LOW=claude-haiku-4-5
ANTHROPIC_MODEL_MID=claude-sonnet-5
ANTHROPIC_MODEL_HIGH=claude-opus-4-8
ANTHROPIC_PRICE_IN_LOW=1
ANTHROPIC_PRICE_OUT_LOW=5
ANTHROPIC_PRICE_IN_MID=3
ANTHROPIC_PRICE_OUT_MID=15
ANTHROPIC_PRICE_IN_HIGH=5
ANTHROPIC_PRICE_OUT_HIGH=25

# Provider locali (nessuna fattura API). Endpoint OpenAI-compatibile.
# Ollama: `ollama pull qwen3:8b` poi punta un gradino su "ollama".
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL_LOW=qwen3:8b
OLLAMA_MODEL_MID=qwen3:14b
OLLAMA_MODEL_HIGH=qwen3:14b
# MLX (Apple Silicon): avvia mlx_lm.server in loopback, poi mappa i modelli.
MLX_BASE_URL=http://127.0.0.1:8080/v1
MLX_MODEL_LOW=
MLX_MODEL_MID=
MLX_MODEL_HIGH=

# Scala a tre gradini di costo crescente. Modello e reasoning effort salgono insieme.
# Il router parte dal basso e sale solo su segnale esplicito.
OPENAI_MODEL_LOW=gpt-5.6-luna
OPENAI_MODEL_MID=gpt-5.6-terra
OPENAI_MODEL_HIGH=gpt-5.6-sol
OPENAI_EFFORT_LOW=low
OPENAI_EFFORT_MID=medium
OPENAI_EFFORT_HIGH=high

# Dollari per milione di token. Stanno qui accanto al modello perché chi cambia l'uno deve
# cambiare l'altro: un prezzo che resta indietro non fa rumore, mente e basta.
OPENAI_PRICE_IN_LOW=1
OPENAI_PRICE_OUT_LOW=6
OPENAI_PRICE_IN_MID=2.5
OPENAI_PRICE_OUT_MID=15
OPENAI_PRICE_IN_HIGH=5
OPENAI_PRICE_OUT_HIGH=30

# Due soglie, due domande. «L'obiettivo è raggiunto?» → sotto 0.7 l'agente riprova.
# «Questo gradino ce la fa?» → sotto 0.5 il router compra un modello più caro.
# Fra le due si riprova con lo stesso modello. Vedi evals/calibrate_grader.py.
HARNESS_RUBRIC_THRESHOLD=0.7
HARNESS_ESCALATION_THRESHOLD=0.5

# Limiti del runner.
HARNESS_MAX_CONTINUATIONS=3
HARNESS_MAX_TOOL_CALLS=40
HARNESS_TOOL_OUTPUT_LIMIT=12000

# Budget di contesto realmente applicato (Fase 1). La finestra utile è
# HARNESS_CONTEXT_WINDOW - HARNESS_RESERVED_OUTPUT_TOKENS; oltre warning si segnala,
# oltre compaction si riduce il contesto.
HARNESS_CONTEXT_WINDOW=128000
HARNESS_RESERVED_OUTPUT_TOKENS=4000
HARNESS_CONTEXT_WARNING_RATIO=0.7
HARNESS_CONTEXT_COMPACTION_RATIO=0.8

# Funzioni opzionali.
HARNESS_ENABLE_WEB_SEARCH=true
HARNESS_ENABLE_BROWSER=true
HARNESS_ENABLE_MCP=true
HARNESS_REQUIRE_APPROVAL=true

# Trigger (cron/webhook). Disabilitati di default: lo scheduler parte solo se abilitato,
# e il tick è ogni quanti secondi controlla i cron.
HARNESS_ENABLE_TRIGGERS=false
HARNESS_TRIGGER_TICK_SECONDS=30

# Tracing opzionale.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langchain-agent-harness

# Immagine costruita con: make sandbox-image
HARNESS_SANDBOX_IMAGE=langchain-harness-sandbox:latest
